---
/** Les quatre régimes de contenu : forme + mot + couleur, en italique de marge. */
interface Props {
  kind: 'fait' | 'hypothese' | 'demo' | 'experience';
}
const LABEL = {
  fait: 'fait attesté',
  hypothese: 'hypothèse',
  demo: 'démonstration',
  experience: 'résultat expérimental',
} as const;
const { kind } = Astro.props;
---

<span class={`regime ${kind}`}>{LABEL[kind]}</span>
