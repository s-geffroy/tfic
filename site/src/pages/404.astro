---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url.ts';
---

<Base title="Page introuvable" description="Cette page n’existe pas sur le site TFIC-PN.">
  <h1>Page introuvable</h1>
  <p>Cette adresse ne correspond à aucune page. Les identifiants du corpus sont sensibles à la casse (par exemple <code>S07</code> ou <code>D023</code>).</p>
  <p><a href={href()}>Retour à l’accueil</a> ou <a href={href('corpus')}>consulter le corpus</a>.</p>
</Base>
